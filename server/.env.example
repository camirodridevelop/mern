# Copiá este archivo como ".env" y completá tus datos. NUNCA subas el .env a GitHub.
DB_USER=tu_usuario_de_mongodb
DB_PASS=tu_contraseña_de_mongodb
DB_HOST=tu-cluster.mongodb.net
IP_SERVER=localhost
API_VERSION=v1
# Clave secreta para firmar los tokens (usá un texto largo y aleatorio)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
